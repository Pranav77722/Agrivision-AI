# ============================================
# Agrivision AI+ Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Database (PostgreSQL / Supabase) ----
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agrivision
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ---- Supabase Storage ----
SUPABASE_STORAGE_BUCKET=agrivision-images
SUPABASE_REPORTS_BUCKET=agrivision-reports

# ---- ML Models ----
MODEL_WEIGHTS_DIR=./ml/models/weights
DISEASE_MODEL_PATH=./ml/models/weights/efficientnetb3_disease.h5
ENSEMBLE_VGG16_PATH=./ml/models/weights/vgg16_disease.h5
ENSEMBLE_VGG19_PATH=./ml/models/weights/vgg19_disease.h5
ENSEMBLE_INCEPTION_PATH=./ml/models/weights/inceptionv3_disease.h5
ENSEMBLE_RESNET_PATH=./ml/models/weights/resnet101v2_disease.h5
YOLO_MODEL_PATH=./ml/models/weights/yolov8_pest.pt
SEVERITY_MODEL_PATH=./ml/models/weights/unet_severity.h5
YIELD_MODEL_PATH=./ml/models/weights/xgboost_yield.joblib

# ---- Weather API ----
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ---- Translation / Multilingual ----
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_ULCA_API_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference

# ---- LLM Provider (AI Assistant) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ---- Mobile App ----
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
